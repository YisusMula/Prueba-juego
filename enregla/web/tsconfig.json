{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "allowImportingTsExtensions": false,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "noEmit": true,
    "types": ["vite/client", "vite-plugin-pwa/client", "node", "@testing-library/jest-dom/vitest"],
    "paths": {
      "@/*": ["./src/*"],
      "@shared/schemas": ["../server/src/schemas/index.ts"],
      "zod": ["./node_modules/zod"]
    }
  },
  "include": ["src", "e2e", "scripts", "vite.config.ts", "vite.demo.config.ts", "playwright.config.ts", "eslint.config.js", "../server/src/schemas/index.ts"]
}
