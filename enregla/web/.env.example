# Nombre comercial visible en toda la interfaz (una sola fuente de verdad).
VITE_APP_NAME=EnRegla

# URL pública de la web (sin barra final): enlace canonical, Open Graph y sitemap.xml.
VITE_PUBLIC_URL=https://app.tudominio.es

# Email de soporte (opcional): pie de la web, Facturación y pantallas de error.
VITE_SUPPORT_EMAIL=

# --- Datos legales del titular (OBLIGATORIOS para `npm run build` de producción) ---------
# Si falta alguno, en desarrollo se ven marcadores resaltados y el build de producción FALLA
# con la lista de lo que falta.
VITE_LEGAL_OWNER_NAME=
VITE_LEGAL_TAX_ID=
VITE_LEGAL_ADDRESS=
VITE_LEGAL_CONTACT_EMAIL=
VITE_LEGAL_HOSTING_PROVIDER=
# Fecha de última actualización de los textos legales, tal como se mostrará (p. ej. «10 de noviembre de 2026»).
VITE_LEGAL_LAST_UPDATED=

# --- Opcionales (si faltan, el texto se adapta) ---------------------------------------
VITE_LEGAL_REGISTRY_DATA=
VITE_LEGAL_HOSTING_LOCATION=
VITE_LEGAL_EMAIL_PROVIDER=
VITE_LEGAL_JURISDICTION=

# Solo para compilaciones de prueba (e2e/CI) sin datos reales: permite compilar con marcadores.
# NUNCA en producción.
# VITE_ALLOW_PLACEHOLDER_LEGAL=true
