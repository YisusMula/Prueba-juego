# =============================================================================
# EnRegla — configuración del servidor (copia este fichero a .env y ajústalo)
# Todas las variables se validan con zod al arrancar. En producción el servidor
# NO arranca si falta algo obligatorio o si un secreto es débil.
# Nunca subas el fichero .env al repositorio.
# =============================================================================

# Entorno: development | production | test
NODE_ENV=development

# Interfaz y puerto de escucha
HOST=0.0.0.0
PORT=3000

# Nivel de log (fatal|error|warn|info|debug|trace|silent). Por defecto: info.
# Los logs nunca incluyen contraseñas, tokens, PIN ni cookies (redacción configurada).
LOG_LEVEL=info

# PostgreSQL. En producción la contraseña debe tener >= 12 caracteres y no ser un valor por defecto.
# Si la contraseña lleva caracteres especiales (@ : / # ? %), en DATABASE_URL hay que codificarlos
# (encodeURIComponent). Alternativa sin codificar: deja DATABASE_URL vacío y usa
# PGHOST, PGPORT, PGUSER, PGPASSWORD y PGDATABASE (es lo que hacen los docker-compose).
# Cada conexión lleva statement_timeout=30s, idle_in_transaction_session_timeout=60s y lock_timeout=15s.
DATABASE_URL=postgres://enregla:enregla@localhost:5432/enregla_dev
DATABASE_POOL_MAX=10
# Aplica las migraciones pendientes al arrancar (true por defecto). Ponlo a false si migras aparte.
MIGRATE_ON_START=true

# Nombre comercial visible en emails, PDF y textos. Cambiar la marca = cambiar SOLO esto.
APP_NAME=EnRegla

# URL pública de la aplicación (origen de la SPA). Se usa para:
#  - validar Origin en peticiones mutantes (CSRF)
#  - construir los enlaces de los emails y las URLs de retorno de Stripe
# En producción debe ser https.
APP_URL=http://localhost:5173

# Orígenes adicionales aceptados para CORS/CSRF, separados por comas (solo desarrollo,
# p. ej. si el servidor de Vite no hace proxy). Prohibido en producción.
DEV_ORIGINS=

# Proxy inverso delante del servidor: false | número de saltos | lista de IP/CIDR del proxy.
# Afecta a la IP usada en rate limiting y auditoría. Usa 1 detrás de un único proxy, o mejor
# la IP/subred del proxy (p. ej. 172.30.0.0/24). `true` está PROHIBIDO en producción (permite
# falsificar la IP con X-Forwarded-For). La app no debe ser accesible sin pasar por el proxy.
TRUST_PROXY=false

# Cookie Secure. Por defecto true en producción y false en desarrollo (http).
# Con Secure la cookie se llama __Host-enregla_session; sin Secure, enregla_session.
# COOKIE_SECURE=true

# Sesiones: caducidad absoluta (días) e inactividad (horas)
SESSION_ABSOLUTE_DAYS=30
SESSION_IDLE_HOURS=168

# Días de prueba gratuita. Es UNA prueba por cuenta: empieza con el primer local que crea
# el usuario y los siguientes heredan la misma fecha de fin.
TRIAL_DAYS=14

# Retención (tarea diaria): meses de auditoría y días para borrar cuentas sin verificar.
AUDIT_RETENTION_MONTHS=12
UNVERIFIED_ACCOUNT_DAYS=7

# Informes PDF generándose a la vez por proceso (el resto recibe 429 con Retry-After).
PDF_MAX_CONCURRENCY=2

# -----------------------------------------------------------------------------
# Email
# MAIL_TRANSPORT: smtp | console | memory  (por defecto: smtp en producción,
# console en desarrollo —imprime los emails, con sus enlaces, por consola—, memory en test)
# -----------------------------------------------------------------------------
MAIL_TRANSPORT=console
# Solo la dirección: el nombre visible del remitente se toma de APP_NAME.
MAIL_FROM=no-reply@example.com
SMTP_HOST=
SMTP_PORT=587
# true para TLS implícito (puerto 465); con false se exige STARTTLS.
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# -----------------------------------------------------------------------------
# Stripe (opcional). Define las CUATRO variables o ninguna.
# Sin Stripe, los endpoints de facturación responden 503 y el resto funciona.
# -----------------------------------------------------------------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Price IDs de los planes (12 €/mes y 120 €/año por local)
STRIPE_PRICE_MONTHLY=
STRIPE_PRICE_ANNUAL=

# -----------------------------------------------------------------------------
# Tareas programadas en proceso (recordatorio diario y limpieza de datos caducados).
# Seguras con varias instancias (advisory lock de PostgreSQL).
# -----------------------------------------------------------------------------
SCHEDULER_ENABLED=true
SCHEDULER_INTERVAL_SECONDS=60

# Bandeja de salida de emails (tabla email_outbox): el primer envío es inmediato; si el SMTP
# falla, este worker reintenta con backoff (30 s → 2 min → 10 min → … → ~24 h). Seguro con varias
# instancias. Los emails enviados se purgan a las 6 h y los fallidos a los 3 días.
EMAIL_WORKER_ENABLED=true
EMAIL_WORKER_INTERVAL_SECONDS=15

# Días que un local "pendiente de eliminación" se conserva (solo lectura, restaurable) antes de purgarlo.
ORG_DELETION_GRACE_DAYS=30

# Carpeta del build del frontend. Por defecto ../web/dist (relativa a server/).
# Si no existe, el servidor funciona solo como API.
# WEB_DIST_DIR=

# Solo para docker-compose: contraseña del usuario de PostgreSQL del contenedor `db`.
# Los compose la pasan a la app como PGPASSWORD (no dentro de una URL): puede llevar cualquier carácter.
POSTGRES_PASSWORD=cambia-esta-clave-larga
# Solo para docker-compose.prod.yml (servicio `backup`, ver docs/OPERACIONES.md):
# BACKUP_RETENTION_DAYS=14
# BACKUP_HOUR_UTC=3
# Comando tras cada copia (la ruta va en BACKUP_FILE; en este fichero se escribe $$ por compose):
# BACKUP_POST_HOOK=rclone copy "$$BACKUP_FILE" remoto:enregla-backups
# Solo para docker-compose.prod.yml (Caddy con TLS automático):
# DOMAIN=app.tudominio.es
# ACME_EMAIL=tu@email.es
