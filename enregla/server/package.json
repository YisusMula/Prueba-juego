{
  "name": "enregla-server",
  "version": "0.1.0",
  "description": "Backend de EnRegla (API APPCC)",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node --env-file-if-exists=.env dist/server.js",
    "migrate": "tsx --env-file-if-exists=.env src/db/migrate-cli.ts",
    "migrate:prod": "node --env-file-if-exists=.env dist/db/migrate-cli.js",
    "seed:demo": "tsx --env-file-if-exists=.env src/scripts/seed-demo.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint ."
  },
  "license": "UNLICENSED",
  "dependencies": {
    "@fastify/cookie": "^11.1.5",
    "@fastify/cors": "^11.4.1",
    "@fastify/helmet": "^13.2.0",
    "@fastify/static": "^10.1.10",
    "@node-rs/argon2": "^2.2.2",
    "fastify": "^5.12.8",
    "fontkit": "^2.0.4",
    "kysely": "^0.29.8",
    "nodemailer": "^10.4.0",
    "pdfkit": "^0.20.2",
    "pg": "^8.23.1",
    "stripe": "^23.1.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.5",
    "@types/nodemailer": "^8.0.2",
    "@types/pdfkit": "^0.17.7",
    "@types/pg": "^8.23.1",
    "eslint": "^10.14.0",
    "pino-pretty": "^13.2.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.2",
    "vitest": "^5.1.0"
  },
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "exports": {
    "./schemas": "./src/schemas/index.ts"
  }
}
