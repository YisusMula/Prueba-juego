node_modules/
dist/
.env
.env.*
!.env.example
*.log
backups/
dist-demo/
deploy/secrets/*.env
# N10: cualquier variante de los secretos (copias .bak/.orig/~, otros nombres); solo los ejemplos.
deploy/secrets/*
!deploy/secrets/*.example
# Copias de la base de datos y volcados, estén donde estén.
*.dump
*.dump.sha256
*.sql.gz
*.partial
# N10: copias de los secretos FUERA de deploy/secrets/ (p. ej. deploy/secrets-old/db.env, owner.env en la raíz).
**/db.env*
**/owner.env*
**/backup.env*
**/app-db.env*
**/*.env.bak
**/*.env.orig
**/*.env~
**/*.env.old
!**/*.example
